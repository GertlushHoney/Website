# Shopify Storefront API (headless commerce engine — see /docs/technical-architecture.md
# and /docs/launch-checklist.md). Get the token via the Headless sales channel app (Shopify
# App Store), not the deprecated "Develop apps" custom-app Storefront token flow. Never use
# an Admin API token (prefixed shpat_) here.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Shopify Admin API — used ONLY for tagging a customer with which sold-out
# product they want a restock alert for (src/lib/shopify/admin-client.ts),
# so Shopify Email can filter a send by tag. Server-only, never referenced
# from a client component. Create a custom app via the Dev Dashboard
# (dev.shopify.com/dashboard), scope it to ONLY read_customers +
# write_customers, install it on this store, then copy the Client ID and
# Client secret from the app's Settings tab — not a token; this codebase
# exchanges these for a short-lived token itself. See
# docs/launch-checklist.md point 10.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Sanity (editorial content — beekeepers, apiaries, batches, journal, etc.)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Sanity write access — used ONLY to create a new (unapproved) productReview
# document when a visitor submits a review (src/lib/sanity/submit-review.ts).
# Separate from SANITY_API_READ_TOKEN on purpose, same reasoning as the
# Shopify Admin/Storefront split above. Generate via manage.sanity.io →
# your project → API → Tokens → Add API token, with Editor (create)
# permission. Without this, the review form fails gracefully with "not
# available right now" rather than breaking the page.
SANITY_API_WRITE_TOKEN=

# Canonical site URL, used for metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://www.gertlushhoney.co.uk

# Pre-launch site-wide password gate (src/middleware.ts). Set both to enable
# a Basic Auth prompt on every page; leave both unset to disable the gate
# (e.g. once ready to launch publicly) — the /studio gate below is
# independent and keeps working either way.
SITE_PASSWORD_USER=
SITE_PASSWORD=

# Permanent /studio password gate (src/middleware.ts), independent of the
# pre-launch gate above — stays in place even after that one's removed at
# launch. Sanity Studio already has its own real login behind this; this is
# an extra layer in front of the /studio URL itself. Set both to enable;
# leave unset to disable.
STUDIO_PASSWORD_USER=
STUDIO_PASSWORD=
